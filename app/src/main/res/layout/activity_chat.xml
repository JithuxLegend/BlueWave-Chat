<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_cosmic_gradient"
    android:orientation="vertical">

    <!-- Top Chat Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1120"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chatPeerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connected Peer"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bluetooth Direct • Hold message to delete"
                android:textColor="#60A5FA"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVoiceCall"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#1E3A8A"
            android:text="Call"
            android:textAllCaps="false"
            android:textColor="#93C5FD"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Chat Messages List -->
    <ListView
        android:id="@+id/chatListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:paddingVertical="8dp"
        android:stackFromBottom="true"
        android:transcriptMode="alwaysScroll" />

    <!-- Bottom Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B1120"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/inputMessage"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bubble_received"
            android:hint="Message via Bluetooth..."
            android:inputType="textCapSentences|textMultiLine"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#2563EB"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
      
